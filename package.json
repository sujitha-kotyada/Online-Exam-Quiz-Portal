{
  "name": "online-exam-quiz-portal-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Online Exam & Quiz Portal (MERN Stack)",
  "scripts": {
    "server:install": "npm --prefix server install",
    "client:install": "npm --prefix client install",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm --prefix server test && npm --prefix client test",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed:teacher": "npm --prefix server run seed:teacher",
    "seed:demo": "npm --prefix server run seed:demo"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0"
  }
}
